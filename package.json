{
  "name": "studious-ai",
  "private": true,
  "version": "1.0.0",
  "description": "AI-powered student study workspace with notes, drawing, flashcards and a built-in browser",
  "author": {
    "name": "Paras Sarode",
    "email": "paras@studiousai.app"
  },
  "homepage": "https://github.com/paras-sarode/studious-ai",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:compile": "node electron/build.mjs",
    "electron:dev": "npm run electron:compile && concurrently -k \"cross-env BROWSER=none vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron . --no-sandbox\"",
    "electron:build": "npm run electron:compile && vite build && electron-builder",
    "electron:build:linux": "npm run electron:compile && vite build && electron-builder --linux",
    "electron:build:win": "npm run electron:compile && vite build && electron-builder --win",
    "electron:build:mac": "npm run electron:compile && vite build && electron-builder --mac",
    "pwa:build": "vite build",
    "pwa:preview": "vite preview --port 4173",
    "icons:generate": "node scripts/generate-icons.mjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist dist-electron",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-resizable-panels": "^4.11.2",
    "react-router-dom": "^7.15.1",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^14.0.0",
    "vite": "^6.2.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.40",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.studiousai.app",
    "productName": "Studious AI",
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "electron/**/*.cjs.map",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "icon": "assets/icon.png",
      "synopsis": "AI-powered student study workspace"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "assets/icon.png",
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Studious AI"
    },
    "dmg": {
      "title": "Studious AI",
      "window": {
        "width": 540,
        "height": 380
      }
    }
  }
}
